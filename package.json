{
  "name": "tally",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22 <23 || >=24"
  },
  "scripts": {
    "build:shared": "npm run build -w @tally/shared",
    "postinstall": "npm run build:shared",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "mobile": "npm run start -w @tally/mobile",
    "android": "npm run android -w @tally/mobile",
    "phone": "sh scripts/phone.sh",
    "test:db": "vitest run --root supabase/tests",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript > apps/mobile/src/lib/database.types.ts",
    "studio": "sh scripts/studio.sh",
    "icons": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/supabase-js": "^2.118.0",
    "supabase": "^3.0.0",
    "typescript": "~6.0.3",
    "vitest": "4.0.18"
  },
  "overrides": {
    "vitest": "4.0.18"
  }
}
